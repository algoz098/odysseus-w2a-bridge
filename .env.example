# Template for .env. Copy to `.env` and fill in. NEVER commit `.env`.
#
#     cp .env.example .env && chmod 600 .env
#
# Then load it into the extension's settings (keeps the password out of
# shell history and out of `ps`):
#
#     python3 tests/load_credentials.py --verify
#
# The password is not optional for the REST surface. whats2api issues two
# different credentials and only one of them works there:
#
#   * a long-lived MCP token, for /mcp/<token> — used by the MCP server
#     integration, and
#   * a daily JWT, minted by POST /authentication from the account email
#     and password below — this is what GET /connections and
#     POST /connections/request actually check.
#
# Handing the REST surface the MCP token returns
# `401 {"message": "jwt malformed", "className": "JsonWebTokenError"}`:
# the token is 64 hex characters with no dots, and a JWT has two.

WHATS2API_EMAIL=you@example.com
WHATS2API_PASSWORD=

# Destination for tests/smoke_live.py --send. Optional; a JID is derived
# from it. Read-only runs do not use it.
WHATS2API_SMOKE_TO=